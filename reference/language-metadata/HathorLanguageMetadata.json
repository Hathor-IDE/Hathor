{
  "schemaVersion": 1,
  "hathorEngineCompat": "0.1.0",
  "strudelMiniNotationCompat": "1.2.6",
  "chuckLibVersion": "3.8.3",
  "chuckIntegrationSurface": "B4-K3",
  "functions": [
    {
      "name": "s",
      "signature": "s(pattern: string)",
      "description": "Play a sample pattern. Alias for sound().",
      "category": "pattern",
      "supported": true,
      "example": "s(\"bd hh sd\")"
    },
    {
      "name": "sound",
      "signature": "sound(pattern: string)",
      "description": "Play a sample pattern by name. This is the primary entry point for sample-based sequences.",
      "category": "pattern",
      "supported": true,
      "example": "sound(\"bd hh sd hh\")"
    },
    {
      "name": "note",
      "signature": "note(pattern: string)",
      "description": "Play pitched notes. Notes are specified as note names with octaves (e.g. 'c3').",
      "category": "pattern",
      "supported": false,
      "example": "note(\"c3 e3 g3\")"
    },
    {
      "name": "n",
      "signature": "n(pattern: string)",
      "description": "Play notes by number. Use with .scale() for musical notes.",
      "category": "pattern",
      "supported": false,
      "example": "n(\"0 2 4\")"
    },
    {
      "name": "fast",
      "signature": "fast(multiplier: number)",
      "description": "Speed up pattern by multiplier (e.g. 2 = twice as fast).",
      "category": "pattern",
      "supported": true,
      "example": "s(\"bd\").fast(2)"
    },
    {
      "name": "slow",
      "signature": "slow(divisor: number)",
      "description": "Slow down pattern by divisor (e.g. 2 = half speed).",
      "category": "pattern",
      "supported": true,
      "example": "s(\"bd\").slow(2)"
    },
    {
      "name": "stack",
      "signature": "stack(...patterns: Pattern[])",
      "description": "Play multiple patterns simultaneously.",
      "category": "pattern",
      "supported": true,
      "example": "stack(s(\"bd\"), s(\"sn\"))"
    },
    {
      "name": "cat",
      "signature": "cat(...patterns: Pattern[])",
      "description": "Concatenate patterns, playing one after another.",
      "category": "pattern",
      "supported": false,
      "example": "cat(s(\"bd\"), s(\"sn\"))"
    },
    {
      "name": "seq",
      "signature": "seq(...values: any[])",
      "description": "Sequence values over time.",
      "category": "pattern",
      "supported": false,
      "example": "seq(\"bd\", \"sn\", \"hh\")"
    },
    {
      "name": "fastcat",
      "signature": "fastcat(...patterns: Pattern[])",
      "description": "Fast concatenation of patterns (space-separated in mini-notation).",
      "category": "pattern",
      "supported": true,
      "example": "s(\"bd sn hh cp\")"
    },
    {
      "name": "slowcat",
      "signature": "slowcat(...patterns: Pattern[])",
      "description": "Slow concatenation of patterns (angle-bracket syntax in mini-notation).",
      "category": "pattern",
      "supported": true,
      "example": "s(\"<bd sn hh\")"
    },
    {
      "name": "rev",
      "signature": "rev()",
      "description": "Reverse the pattern within each cycle.",
      "category": "pattern",
      "supported": false,
      "example": "s(\"bd sn hh cp\").rev()"
    },
    {
      "name": "every",
      "signature": "every(cycle: number, func: Function)",
      "description": "Apply function every N cycles.",
      "category": "pattern",
      "supported": false,
      "example": "s(\"bd sn\").every(3, rev)"
    },
    {
      "name": "sometimes",
      "signature": "sometimes(func: Function)",
      "description": "Apply function randomly 50% of the time.",
      "category": "effect",
      "supported": false,
      "example": "s(\"hh*8\").sometimes(fast(2))"
    },
    {
      "name": "gain",
      "signature": "gain(value: number | Pattern)",
      "description": "Set volume. Values from 0 to 1.",
      "category": "effect",
      "supported": true,
      "example": "s(\"bd\").gain(0.5)"
    },
    {
      "name": "pan",
      "signature": "pan(value: number | Pattern)",
      "description": "Stereo pan. 0 = left, 0.5 = center, 1 = right.",
      "category": "effect",
      "supported": true,
      "example": "s(\"bd\").pan(\"0 0.25 0.5 0.75\")"
    },
    {
      "name": "speed",
      "signature": "speed(value: number | Pattern)",
      "description": "Playback speed of sample. 1 = normal, 0.5 = half speed.",
      "category": "effect",
      "supported": true,
      "example": "s(\"bd\").speed(1.5)"
    },
    {
      "name": "cut",
      "signature": "cut(group: number | Pattern)",
      "description": "Stops a playing sample when another sample with the same cut group is triggered.",
      "category": "effect",
      "supported": true,
      "example": "s(\"[oh hh]*4\").cut(1)"
    },
    {
      "name": "begin",
      "signature": "begin(amount: number | Pattern)",
      "description": "Start offset in sample (0 to 1). Skips the beginning.",
      "category": "effect",
      "supported": true,
      "example": "s(\"bd\").begin(0.25)"
    },
    {
      "name": "end",
      "signature": "end(amount: number | Pattern)",
      "description": "End offset in sample (0 to 1). Cuts off the end.",
      "category": "effect",
      "supported": true,
      "example": "s(\"bd\").end(0.75)"
    },
    {
      "name": "cutoff",
      "signature": "cutoff(frequency: number | Pattern)",
      "description": "Per-voice low-pass filter cutoff frequency in Hz.",
      "category": "effect",
      "supported": true,
      "example": "s(\"bd\").cutoff(20000)"
    },
    {
      "name": "room",
      "signature": "room(size: number | Pattern)",
      "description": "Add reverb. Size from 0 to 1.",
      "category": "effect",
      "supported": false,
      "example": "s(\"bd\").room(0.5)"
    },
    {
      "name": "delay",
      "signature": "delay(level: number | Pattern)",
      "description": "Add delay. Level between 0 and 1.",
      "category": "effect",
      "supported": false,
      "example": "s(\"bd\").delay(0.25)"
    },
    {
      "name": "orbit",
      "signature": "orbit(n: number | Pattern)",
      "description": "Sends the pattern to a different audio orbit for dedicated effects.",
      "category": "control",
      "supported": false,
      "example": "s(\"bd\").orbit(2)"
    }
  ],
