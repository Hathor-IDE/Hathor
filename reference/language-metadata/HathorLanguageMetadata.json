  "operators": [
    {
      "name": "*",
      "description": "Multiply/speed up - plays the pattern faster. *2 plays twice as fast (twice per cycle).",
      "example": "s(\"bd*4\")"
    },
    {
      "name": "/",
      "description": "Divide/slow down - stretches the pattern over multiple cycles. /2 plays over 2 cycles.",
      "example": "s(\"bd sn\")/2"
    },
    {
      "name": "!",
      "description": "Replicate - repeats the event without speeding up (unlike *).",
      "example": "s(\"bd!3 sn\")"
    },
    {
      "name": "~",
      "description": "Rest/silence - produces no sound for that step.",
      "example": "s(\"bd ~ sn ~\")"
    },
    {
      "name": ",",
      "description": "Parallel/polyphony - plays multiple patterns simultaneously (stack).",
      "example": "s(\"bd, sn, hh\")"
    },
    {
      "name": "|",
      "description": "Random choice - randomly selects between alternatives each cycle.",
      "example": "s(\"bd|sn|hh\")"
    }
  ],
  "grammar": [
    {
      "name": "atom",
      "syntax": "any non-special character sequence",
      "description": "A leaf token: \"bd\", \"sn\", \"~\", etc. The simplest pattern element.",
      "example": "bd",
      "supported": true
    },
    {
      "name": "sequence",
      "syntax": "space-separated elements",
      "description": "Space-separated elements form a fast sequential pattern (fastcat).",
      "example": "bd sn hh cp",
      "supported": true
    },
    {
      "name": "bracket_sequence",
      "syntax": "[a b c]",
      "description": "Square brackets group events into a subsequence that shares a time slot.",
      "example": "[bd sn] hh",
      "supported": true
    },
    {
      "name": "stack",
      "syntax": "comma-separated elements",
      "description": "Comma-separated elements play simultaneously (stack).",
      "example": "bd, sn, hh",
      "supported": true
    },
    {
      "name": "slow_sequence",
      "syntax": "<a b c>",
      "description": "Angle brackets create a polymeter/slowcat — one element per cycle.",
      "example": "<bd sn hh>",
      "supported": true
    },
    {
      "name": "fast",
      "syntax": "child*N",
      "description": "Speed up by factor N. child*N lowers to fast(N, child).",
      "example": "bd*4",
      "supported": true
    },
    {
      "name": "slow",
      "syntax": "child/N",
      "description": "Slow down by factor N. child/N lowers to slow(N, child).",
      "example": "bd/2",
      "supported": true
    },
    {
      "name": "replicate",
      "syntax": "child!N",
      "description": "Repeat child N times without speeding up. child!N lowers to fastcat of N copies.",
      "example": "bd!3 sn",
      "supported": true
    },
    {
      "name": "euclid",
      "syntax": "child(pulses,steps[,rotation])",
      "description": "Euclidean rhythm with pulses onsets over steps total steps, optionally rotated.",
      "example": "bd(3,8)",
      "supported": true
    },
    {
      "name": "sample_selector",
      "syntax": "name:index",
      "description": "Select a specific sample variation by index within a folder.",
      "example": "bd:3",
      "supported": true
    }
  ],
  "params": [
    {
      "key": "s",
      "valueType": "string",
      "description": "Sample folder name (e.g. \"bd\", \"sn\", \"hh\"). This is the value emitted by the mini-notation parser for each atom.",
      "supported": true
    },
    {
      "key": "n",
      "valueType": "int",
      "description": "Sample index within the folder (0-based). Default 0.",
      "supported": true
    },
    {
      "key": "gain",
      "valueType": "double",
      "description": "Output gain multiplier. 1.0 = unity gain.",
      "supported": true
    },
    {
      "key": "speed",
      "valueType": "double",
      "description": "Playback speed multiplier. 1.0 = normal speed.",
      "supported": true
    },
    {
      "key": "pan",
      "valueType": "double",
      "description": "Stereo pan position. -1.0 = hard left, 0.0 = center, 1.0 = hard right.",
      "supported": true
    },
    {
      "key": "begin",
      "valueType": "double",
      "description": "Start offset within the sample, in seconds.",
      "supported": true
    },
    {
      "key": "end",
      "valueType": "double",
      "description": "End offset within the sample, in seconds. 0.0 means play to end.",
      "supported": true
    },
    {
      "key": "cut",
      "valueType": "int",
      "description": "Cut group identifier. Voices sharing a cut group mute each other.",
      "supported": true
    },
    {
      "key": "cutoff",
      "valueType": "double",
      "description": "Per-voice biquad low-pass cutoff frequency in Hz.",
      "supported": true
    },
    {
      "key": "resonance",
      "valueType": "double",
      "description": "Per-voice biquad low-pass resonance / Q factor.",
      "supported": true
    }
  ],
